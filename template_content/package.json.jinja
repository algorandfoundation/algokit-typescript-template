{
  "name": "smart_contracts",
  "version": "1.0.0",
  "description": "Smart contract deployer",
  "main": "smart_contracts/index.ts",
  "type": "module",
  "scripts": {
    "build": "algokit compile ts smart_contracts --output-source-map --out-dir artifacts && algokit generate client smart_contracts/artifacts --output {app_spec_dir}/{contract_name}Client.ts",
    "deploy": "tsx watch -r dotenv/config smart_contracts/index.ts",
    "deploy:ci": "tsx -r dotenv/config smart_contracts/index.ts",
    {%- if use_linter  %}
    "lint": "eslint smart_contracts",
    "lint:fix": "eslint smart_contracts --fix",
    {%- endif %}
    {%- if use_audit  %}
    "audit": "better-npm-audit audit",
    {%- endif %}
    {%- if use_prettier  %}
    "format": "prettier --write .",
    {%- endif %}
    {%- if use_vitest  %}
    "test": "vitest run --coverage",
    "test:watch": "vitest watch",
    {%- endif %}
    "check-types": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0",
    "npm": ">=9.0"
  },
  "dependencies": {
    "@algorandfoundation/algorand-typescript": "^1.0.1"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-client-generator": "^7.0.0-alpha.5",
    "@algorandfoundation/algokit-utils": "^10.0.0-alpha.40",
    "@algorandfoundation/algokit-utils-debug": "^2.0.0-alpha.2",
    "@algorandfoundation/puya-ts": "^1.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tsconfig/node22": "^22.0.0",
    {%- if use_audit  %}
    "better-npm-audit": "^3.11.0",
    {%- endif %}
    "dotenv": "^16.4.7",
    {%- if use_linter  %}
    "eslint": "^9.18.0",
    "@eslint/js": "^9.18.0",
    "typescript-eslint": "^8.19.1",
    {%- endif %}
    {%- if use_prettier  %}
    "prettier": "^3.4.2",
    {%- endif %}
    "tsx": "^4.19.3",
    {%- if use_vitest  %}
    "@algorandfoundation/algorand-typescript-testing": "^1.0.1",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    {%- endif %}
    "typescript": "^5.7.3"
  },
  "overrides": {
    "esbuild": "0.25.0"
  }
}
